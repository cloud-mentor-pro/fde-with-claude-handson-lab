+def ngay_iso(s):
+    # ngay trong JSON dang yyyy-mm-dd -> dd/mm/yyyy nhu he thong cu
+    return datetime.strptime(s, "%Y-%m-%d").strftime("%d/%m/%Y") if s else ""
+
+
+def doc_json(thu_muc):
+    # Don Module 3 doc ra: moi file mot don. Don can_nguoi_xem thi giu lai, khong nhap.
+    ds, giu_lai = [], []
+    for duong_dan in sorted(glob.glob(os.path.join(thu_muc, "*.json"))):
+        with open(duong_dan, encoding="utf-8") as f:
+            j = json.load(f)
+        if j.get("can_nguoi_xem") == "true":
+            giu_lai.append("%s: %s" % (j["so_don_khach"], j.get("ly_do", "")))
+            continue
+        d = {
+            "MaKH": j["ma_khach"],
+            "NgayDat": ngay_iso(j["ngay_dat"]),
+            "NgayGiao": ngay_iso(j.get("ngay_giao") or "2026-11-30"),
+            "GhiChu": "",
+            "dong": [(x["ma_hang"], str(x["so_luong"])) for x in j["dong"]],
+        }
+        ds.append((j["so_don_khach"], d))
+    return ds, giu_lai
+
